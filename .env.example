# Docker Desktop on Windows. Under Linux/WSL, override these with real mount paths.
VEGAS_DRIVE_D=D:/
VEGAS_DRIVE_F=F:/
# Optional active review queue. Keep each batch's decisions in a separate file.
VEGAS_REVIEW_DATASET=local/training-staged/dataset.json
VEGAS_REVIEW_BATCH=local/review-batches/current.json
VEGAS_REVIEW_SAVED=local/reviews/batch-001.json
